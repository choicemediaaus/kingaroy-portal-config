# Kingaroy — secret NAMES only. Values are never committed.
# Values live in the platform's secret store and in 1Password › Choice › Kingaroy.
# This repo holds no application code; these are the per-client connections
# the platform will hold for Kingaroy. Final names follow the platform's
# config once that exists.

# Payment gateway (Kingaroy's own merchant account, scope §15.1). Provider not chosen (scope §17).
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Xero (Kingaroy's own organisation, scope §7.13)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# Transactional email on Kingaroy's own sending domain (SPF/DKIM/DMARC)
TRANSACTIONAL_EMAIL_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
